[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 40
cover: mode cover
cover: depth 28

[engines]
smtbmc yices

[script]
plugin -i slang
read_slang dma_pkg.sv dma_apb_regs.sv dma_channel.sv dma_rr_arbiter.sv dma_axi_engine.sv dma_top.sv dma_formal_tb.sv --top dma_formal_tb
prep -top dma_formal_tb
async2sync

[files]
../rtl/dma_pkg.sv
../rtl/dma_apb_regs.sv
../rtl/dma_channel.sv
../rtl/dma_rr_arbiter.sv
../rtl/dma_axi_engine.sv
../rtl/dma_top.sv
dma_formal_tb.sv
